POSTGRES_DB=watch
POSTGRES_USER=watch
POSTGRES_PASSWORD=replace-with-strong-postgres-password

SECRET_KEY=replace-with-openssl-rand-hex-48
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

APP_TIMEZONE=America/Santo_Domingo
APP_CURRENCY=DOP

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=watch-repair-images
R2_PUBLIC_BASE_URL=
MAX_IMAGE_UPLOAD_MB=10

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_VISION_TIMEOUT_SECONDS=45

CORS_ORIGINS=https://tutallerrelojero.com,https://www.tutallerrelojero.com,https://taller-relojeria.pages.dev

# Cloudflare Pages variable, configured in Pages dashboard, not on the VPS:
# NEXT_PUBLIC_API_BASE_URL=https://api.tutallerrelojero.com/api/v1
