POSTGRES_DB=watch_staging
POSTGRES_USER=watch
POSTGRES_PASSWORD=replace-with-strong-staging-postgres-password
BACKEND_HOST_PORT=8002
BACKEND_IMAGE=brian2525/relojeria-backend:latest

SECRET_KEY=replace-with-staging-openssl-rand-hex-48
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=admin-staging@example.com
ADMIN_PASSWORD=replace-with-strong-staging-admin-password

APP_TIMEZONE=America/Santo_Domingo
APP_CURRENCY=DOP

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-staging-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-staging-r2-secret-access-key
R2_BUCKET_NAME=watch-repair-images-staging
R2_PUBLIC_BASE_URL=
MAX_IMAGE_UPLOAD_MB=10

OPENAI_API_KEY=replace-with-staging-openai-api-key
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_VISION_TIMEOUT_SECONDS=45

CORS_ORIGINS=https://staging.tutallerrelojero.com

# Cloudflare Pages preview/staging variable:
# NEXT_PUBLIC_API_BASE_URL=https://api-staging.tutallerrelojero.com/api/v1
